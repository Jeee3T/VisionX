# --- VisionX backend configuration -------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=visionx_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# Server
PORT=5000
FLASK_DEBUG=1

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# --- Computer vision defaults (each is overridable per session) ---------------
CV_CAMERA_INDEX=0
CV_CONFIDENCE_THRESHOLD=0.72
CV_DEBOUNCE_FRAMES=6
CV_COOLDOWN_MS=900

# --- Personalized gesture recognition ----------------------------------------
# Off by default: a user has no model until they enrol, and the geometric
# recognizer runs unchanged until they do. These are only the DEFAULTS - each
# user's own opt-in lives in the `personalization` collection.
PERSONALIZATION_DEFAULT_ENABLED=0

# Minimum gap between the model's top two class probabilities before a frame may
# fire a command. Raise it if gestures feel twitchy, lower it if they feel slow.
GESTURE_INTENT_MARGIN=0.15

ENROLLMENT_FRAMES_PER_RECORDING=60
ENROLLMENT_RECORDINGS_PER_GESTURE=3

# Where collected landmark recordings and per-user models live. Both default to
# paths inside the repository that .gitignore excludes. Point them at a data
# volume in a deployment.
# VISIONX_GESTURE_DATA_DIR=/var/lib/visionx/gesture
# VISIONX_USER_MODEL_DIR=/var/lib/visionx/models
# VISIONX_VOICE_MODEL_DIR=/var/lib/visionx/voice

# --- Voice assistant ----------------------------------------------------------
VOICE_DEFAULT_ENABLED=0

# Speech-to-text runs locally; audio never leaves this machine and is never
# stored. Leave the backend blank to auto-detect (faster-whisper preferred).
# VOICE_STT_BACKEND=faster-whisper
VISIONX_WHISPER_MODEL=base.en

# Confidence bands: run automatically at/above EXECUTE, ask for confirmation
# at/above CONFIRM, and stay silent below it.
VOICE_EXECUTE_THRESHOLD=0.75
VOICE_CONFIRM_THRESHOLD=0.50

# Transcripts are command-level telemetry, not audio. Raw audio is never stored.
VOICE_RETAIN_TRANSCRIPTS=1
MAX_UTTERANCE_MB=8
